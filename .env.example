# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Optional fallback or primary AI provider.
OPENAI_API_KEY=""

# SYNC_SECRET_TOKEN: Secret token for Google Sheets synchronization.
# Generate a random string and set it here and in your Apps Script.
SYNC_SECRET_TOKEN=""
VITE_CLOUDINARY_CLOUD_NAME="dew39kqhy"
VITE_CLOUDINARY_UPLOAD_PRESET="fanra_upload"

# Secret token for Google Sheets sync. 
# Set this to a long random string and also use it in Apps Script.
SYNC_SECRET_TOKEN=
